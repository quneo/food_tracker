# Copy to .env and fill in. Secrets stay in .env only (it is git-ignored).

# Telegram bot from @BotFather. The backend uses the token only to check Telegram
# Login / Mini App signatures; the bot uses it to talk to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Shared secret between the bot and the backend: python -c "import secrets; print(secrets.token_urlsafe(48))"
BOT_API_SECRET=

# Public https address of the site: links from the bot, the Mini App menu button and the
# Login Widget (set the same domain in @BotFather -> /setdomain).
PUBLIC_URL=
# Secure cookies (true behind https).
COOKIE_SECURE=false

# invite = new people join only by an invite link from an admin; open = anyone.
REGISTRATION=invite
# Telegram ids of admins, comma separated. Admins can always join and make invites.
ADMIN_TELEGRAM_IDS=
DEFAULT_TIMEZONE=Asia/Krasnoyarsk

# MinIO (photo storage). Also used as MinIO's root user and password.
S3_ACCESS_KEY=food-tracker
S3_SECRET_KEY=
S3_BUCKET=food-tracker

# AI: Codex CLI on the VPS through the runner (see docs/vps-codex.md).
# ssh | local | off. With "off" the app works, the bot only records weights and photos.
AI_RUNNER=off
AI_SSH_TARGET=food-ai@vps.example.com
AI_SSH_PORT=22
# Empty = the model from the runner's Codex config on the VPS.
AI_MODEL=
AI_REASONING_EFFORT=medium
AI_TIMEOUT=240
AI_MAX_PARALLEL=2

# Telegram through an SSH SOCKS tunnel (docker compose --profile tg-proxy).
TELEGRAM_PROXY=
TG_PROXY_SSH_TARGET=

# Host paths and port (docker-compose.yml defaults to ./.local/*).
DATA_DIR=./.local/data
MINIO_DIR=./.local/minio
CODEX_SSH_DIR=./.local/codex-ssh
TG_PROXY_SSH_DIR=./.local/tg-proxy
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8090
