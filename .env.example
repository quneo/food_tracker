# Copy to .env and fill in. Secrets stay in .env only (it is git-ignored).

# Telegram bot from @BotFather. The backend uses the token only to check Telegram
# Login / Mini App signatures; the bot uses it to talk to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Shared secret between the bot and the backend: python -c "import secrets; print(secrets.token_urlsafe(48))"
BOT_API_SECRET=

# Public https address of the site: links from the bot, the Mini App menu button and the
# Login Widget (set the same domain in @BotFather -> /setdomain).
PUBLIC_URL=
# Secure cookies always (https visits get them anyway; keep false to also allow http).
COOKIE_SECURE=false
# Telegram Login Widget on the sign-in page: needs /setdomain for the bot in BotFather.
TELEGRAM_WIDGET=false
# Mini App on the bot's menu button: shows the site's address to anyone who opens the bot.
MENU_BUTTON=false

# Who may join:
#   bastion = sign in on the site with Bastion (the project's groups decide), then link
#             Telegram in the profile; the bot serves linked accounts only;
#   invite  = new people join by an invite link from an admin; open = anyone.
REGISTRATION=invite
# Telegram ids of admins, comma separated (invite/open). Admins can always join.
ADMIN_TELEGRAM_IDS=
# Bastion logins of admins, comma separated (bastion).
ADMIN_USERNAMES=

# Bastion (REGISTRATION=bastion): register the project under "Projects" in Bastion.
BASTION_URL=
BASTION_CLIENT_ID=
BASTION_CLIENT_SECRET=
# Address people open in the browser (to bind a phone); defaults to BASTION_URL.
BASTION_PUBLIC_URL=
DEFAULT_TIMEZONE=Asia/Krasnoyarsk

# MinIO (photo storage). Also used as MinIO's root user and password.
S3_ACCESS_KEY=food-tracker
S3_SECRET_KEY=
S3_BUCKET=food-tracker

# AI: Codex CLI on the VPS through the runner (see docs/vps-codex.md).
# ssh | local | off. With "off" the app works, the bot only records weights and photos.
AI_RUNNER=off
AI_SSH_TARGET=food-ai@vps.example.com
AI_SSH_PORT=22
# Empty = the model from the runner's Codex config on the VPS.
AI_MODEL=
AI_REASONING_EFFORT=medium
AI_TIMEOUT=240
AI_MAX_PARALLEL=2
# Optional: USD per million tokens, to show the cost in the profile next to the tokens.
# Empty = tokens only (with a ChatGPT login Codex is not billed per token).
AI_PRICE_INPUT=
AI_PRICE_CACHED_INPUT=
AI_PRICE_OUTPUT=

# Telegram through an SSH SOCKS tunnel (docker compose --profile tg-proxy).
TELEGRAM_PROXY=
TG_PROXY_SSH_TARGET=

# Host paths and port (docker-compose.yml defaults to ./.local/*).
DATA_DIR=./.local/data
MINIO_DIR=./.local/minio
CODEX_SSH_DIR=./.local/codex-ssh
TG_PROXY_SSH_DIR=./.local/tg-proxy
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8090
